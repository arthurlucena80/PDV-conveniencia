# ============================================================
# .env.example — Modelo de Variáveis de Ambiente
#
# ⚠️  ATENÇÃO: Este arquivo vai ao Git. Não coloque senhas reais!
#
# Como usar:
#   cp .env.example .env
#   (e preencha os valores reais no .env)
#
# Gere uma AUTH_SECRET segura com:
#   openssl rand -base64 32
# ============================================================

# ── Banco de Dados ───────────────────────────────────────────
# Para desenvolvimento local (banco no Docker):
DATABASE_URL="postgresql://pdv_usuario:pdv_senha_segura_2024@localhost:5432/pdv_banco"

# Para usar o Neon (banco em nuvem):
# DATABASE_URL="postgresql://usuario:senha@host.neon.tech/banco?sslmode=require"

# ── Autenticação ─────────────────────────────────────────────
# Chave secreta para os cookies de sessão. DEVE ser aleatória e longa!
# Gere com: openssl rand -base64 32
AUTH_SECRET="substitua-por-uma-chave-aleatoria-longa-e-secreta"

# ── Ambiente ─────────────────────────────────────────────────
NODE_ENV="development"
