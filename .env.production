# ============================================================
# .env.production — Variáveis de Ambiente para a VPS
#
# Copie este arquivo para .env na sua VPS:
#   cp .env.production .env
#
# E lembre-se de alterar as senhas e a AUTH_SECRET abaixo!
# ============================================================

# ── Banco de Dados ───────────────────────────────────────────
POSTGRES_DB="pdv_banco"
POSTGRES_USER="pdv_usuario"
# ⚠️ Altere para uma senha forte na VPS
POSTGRES_PASSWORD="pdv_senha_segura_producao_2024"

# A DATABASE_URL deve refletir os dados acima.
# Para acesso externo via host, seria localhost:5435
# O Docker Compose do Next.js usará a rede interna apontando para 'db:5432'.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5435/${POSTGRES_DB}"

# ── Autenticação ─────────────────────────────────────────────
# Chave secreta para os cookies de sessão. DEVE ser aleatória e longa!
# Gere com: openssl rand -base64 32
# ⚠️ Substitua por uma chave gerada de forma segura na sua VPS!
AUTH_SECRET="substitua-por-uma-chave-aleatoria-longa-e-secreta-em-producao"

# ── Ambiente ─────────────────────────────────────────────────
NODE_ENV="production"
